# ============================================================
# MisterFritz — Environment Configuration
# Copy this file to .env and fill in the values.
# .env is gitignored and will never be committed.
# ============================================================

# ----- Required -----
# Your Discord bot token (from https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=

# The Discord username that has root/admin privileges (file tools, workspace, etc.)
ROOT_USER=

# ----- Ollama -----
# URL of your local (or remote) Ollama instance.
# When running the bot natively: http://127.0.0.1:11434
# When running the bot inside Docker: http://host.docker.internal:11434
OLLAMA_HOST=http://127.0.0.1:11434

# ----- Model names (change only if you use different Ollama model names) -----
THINKING_OLLAMA_MODEL=gpt-oss
FAST_OLLAMA_MODEL=llama3.2
EMBEDDING_MODEL=mxbai-embed-large
VISION_MODEL=llava

# ----- Application config -----
# Description used by the agent to decide when to query local documents.
DOC_STORAGE_DESCRIPTION=anything you don't know about.

# ----- Paths (defaults shown; only set if you need to override) -----
# DOC_FOLDER=./input
# CHROMA_DB_PATH=./chroma_store
# CHROMA_COLLECTION_NAME=word_docs_rag
# CHAT_DB_NAME=chat_history.db

# ----- FFmpeg (only set if not on system PATH) -----
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
