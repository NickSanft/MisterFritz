# ============================================================
# MisterFritz — Environment Configuration
# Copy this file to .env and fill in the values.
# .env is gitignored and will never be committed.
# ============================================================

# ----- Required -----
# Your Discord bot token (from https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=

# The Discord username that has root/admin privileges (file tools, workspace, etc.)
ROOT_USER=

# Additional admin Discord usernames, comma-separated. Anyone in this list gets
# the same powers as ROOT_USER (file tools, /workspace, /schedule add/remove).
# Leave blank for single-admin deployments.
# ADMIN_USERS=alice,bob

# ----- Ollama -----
# URL of your local (or remote) Ollama instance.
# When running the bot natively: http://127.0.0.1:11434
# When running the bot inside Docker: http://host.docker.internal:11434
OLLAMA_HOST=http://127.0.0.1:11434

# ----- Model names (change only if you use different Ollama model names) -----
THINKING_OLLAMA_MODEL=gpt-oss
FAST_OLLAMA_MODEL=llama3.2
EMBEDDING_MODEL=mxbai-embed-large
VISION_MODEL=llava

# ----- Application config -----
# Description used by the agent to decide when to query local documents.
DOC_STORAGE_DESCRIPTION=anything you don't know about.

# ----- Tunables (defaults shown; uncomment to override) -----
# Hard cap on a single Ollama request (seconds). Hung-model protection.
# OLLAMA_TIMEOUT=120
# How long Ollama keeps a model resident after the last request. The default
# matches Ollama's own ("5m"). Set to "-1" to pin models forever — fastest
# response time but VRAM stays consumed. Accepts "30s", "5m", "1h", "-1".
# OLLAMA_KEEP_ALIVE=5m
# Messages-in-conversation threshold before the agent summarises and trims.
# SUMMARIZE_THRESHOLD=15
# Max lines returned by the read_file tool per call.
# MAX_READ_LINES=500
# Max file size (bytes) the file tools will read or search through. 1 MiB default.
# MAX_FILE_SIZE_BYTES=1048576
# Truncation length for execute_command output passed back to the LLM.
# EXEC_OUTPUT_TRUNCATE=10000
# Minimum delay (minutes) for one-shot scheduled tasks.
# SCHEDULE_MIN_DELAY_MIN=1
# Max recurring schedules per user. Abuse cap; bump up for trusted servers.
# MAX_SCHEDULES_PER_USER=10
# Minimum user-message / reply length (chars) to trigger automatic memory
# extraction. Short turns ("hi", "lol") are skipped to save an LLM call.
# MEMORY_EXTRACT_MIN_USER_CHARS=20
# MEMORY_EXTRACT_MIN_REPLY_CHARS=40
# Append-only NDJSON log of /forget and /export events. Useful for compliance
# / "who deleted what" audit trails. Defaults to ./audit.log.
# AUDIT_LOG_PATH=audit.log

# ----- Admin panel (read-only HTML, bound to 127.0.0.1 only) -----
# Set a password to enable the admin panel on :8001. If unset, the panel
# won't start at all. Use any username; the password is what matters.
# ADMIN_PANEL_PASSWORD=
# ADMIN_PANEL_PORT=8001
# Comma-separated allowlist of program names execute_command may invoke.
# The argv[0] basename (sans .exe/.cmd/.bat/.ps1) must match one of these.
# EXEC_ALLOWED_COMMANDS=ls,dir,pwd,cd,echo,cat,type,head,tail,wc,python,python3,pip,pytest,node,npm,npx,git,go,cargo,make,grep,find,where

# ----- Paths (defaults shown; only set if you need to override) -----
# DOC_FOLDER=./input
# CHROMA_DB_PATH=./chroma_store
# CHROMA_COLLECTION_NAME=word_docs_rag
# DB_NAME=fritz.db           # unified database for chat history + schedules
# CHAT_DB_NAME=              # override to split chat history into a separate file
# SCHEDULE_DB=               # override to split schedules into a separate file
# WORKSPACES_ROOT=./workspaces  # parent dir for per-user sandboxed workspaces

# ----- FFmpeg (only set if not on system PATH) -----
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# ----- Whisper STT (faster-whisper) -----
# Model size: tiny | base | small | medium | large-v2 | large-v3
# "small" is the recommended default — good accuracy at reasonable CPU speed.
WHISPER_MODEL=small
# Set to "cuda" if a GPU is available for much faster transcription.
WHISPER_DEVICE=cpu
# Compute type: int8 (fastest CPU), float16 (best GPU), float32 (accurate CPU)
# int8 halves memory and roughly doubles speed with minimal accuracy loss.
WHISPER_COMPUTE_TYPE=int8
# Force a specific language (e.g. "en") to skip auto-detection and speed up inference.
# Leave blank to auto-detect.
# WHISPER_LANGUAGE=
# Beam size: higher = more accurate but slower. 5 is the default.
# WHISPER_BEAM_SIZE=5
# Initial prompt seeds the transcription with context to improve accuracy on domain vocab.
# WHISPER_INITIAL_PROMPT=Mister Fritz is an AI assistant. The user is speaking a conversational message.

# ----- Telegram (optional — only needed if running main_telegram.py) -----
# TELEGRAM_BOT_TOKEN=
