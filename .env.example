# ============================================================
# MisterFritz — Environment Configuration
# Copy this file to .env and fill in the values.
# .env is gitignored and will never be committed.
# ============================================================

# ----- Required -----
# Your Discord bot token (from https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=

# The CANONICAL IDENTITY with root/admin privileges (file tools, workspace, etc).
# Use "discord-<your numeric id>", NOT your username: a username is mutable, so
# a rename used to revoke your own admin rights, and anyone who took the name
# inherited them. Get the number by enabling Developer Mode in Discord and
# right-clicking your name → Copy User ID.
#   ROOT_USER=discord-123456789012345678
# A bare username still works only while ADMIN_LEGACY_NAME_MATCH=true (below).
ROOT_USER=

# Additional admins, comma-separated, same canonical form. Anyone in this list
# gets the same powers as ROOT_USER (file tools, /workspace, /schedule add/remove).
# Leave blank for single-admin deployments.
# ADMIN_USERS=discord-234567890123456789,telegram-987654321

# ----- Ollama -----
# URL of your local (or remote) Ollama instance.
# When running the bot natively: http://127.0.0.1:11434
# When running the bot inside Docker: http://host.docker.internal:11434
OLLAMA_HOST=http://127.0.0.1:11434

# ----- Model names (change only if you use different Ollama model names) -----
THINKING_OLLAMA_MODEL=gpt-oss
FAST_OLLAMA_MODEL=llama3.2
EMBEDDING_MODEL=mxbai-embed-large
VISION_MODEL=llava

# ----- Application config -----
# Description used by the agent to decide when to query local documents.
DOC_STORAGE_DESCRIPTION=anything you don't know about.

# ----- Tunables (defaults shown; uncomment to override) -----
# Hard cap on a single Ollama request (seconds). Hung-model protection.
# OLLAMA_TIMEOUT=120
# How long Ollama keeps a model resident after the last request. The default
# matches Ollama's own ("5m"). Set to "-1" to pin models forever — fastest
# response time but VRAM stays consumed. Accepts "30s", "5m", "1h", "-1".
# OLLAMA_KEEP_ALIVE=5m
# Messages-in-conversation threshold before the agent summarises and trims.
# Raised from 15 to 30 now that summarisation runs off the critical path — a
# higher value buys longer in-thread memory, and nobody waits for the pass.
# This is what bounds the history window in practice: the window can never hold
# more than SUMMARIZE_THRESHOLD+1 messages, because the summariser removes all
# but the last one. Raise both together for longer in-thread continuity.
# SUMMARIZE_THRESHOLD=30
# Token budget for the conversation history fed to the agent each turn. The
# window is a suffix of the thread transcript, trimmed to fit. Budget against
# num_ctx (32768 in modelfiles/): ~900 system prompt + ~1900 tool schemas +
# MEMORY_INJECT_MAX_CHARS/4 + this + room for tool output and the reply.
# Set to 0 to disable the window and send only the latest message.
# HISTORY_TOKEN_BUDGET=4096
# Cap (characters) on the memory blob auto-injected into the system prompt from
# Chroma. Uncapped it can be tens of thousands of chars and evict everything else.
# MEMORY_INJECT_MAX_CHARS=4000
# Characters buffered before the streaming callback fires. 1 = every token;
# raise to coalesce deltas if streaming is too chatty for your network.
# STREAM_MIN_CHARS=1
# Minimum seconds between Discord message edits while a reply streams.
# DISCORD_STREAM_MIN_INTERVAL=1.5
# Run conversation summarisation on a background thread instead of blocking
# the reply that crossed SUMMARIZE_THRESHOLD. Set false to restore the old
# synchronous ordering.
# SUMMARIZE_ASYNC=true
# Worker count for the shared blocking pool that keeps LLM/STT/TTS work off
# the Discord event loop.
# BLOCKING_POOL_SIZE=8
# Concurrent SDXL renders / XTTS syntheses. Both GPU-bound; keep at 1 unless
# you have VRAM to burn. Must be >= 1.
# IMAGE_GEN_MAX_CONCURRENCY=1
# TTS_MAX_CONCURRENCY=1
# Max lines returned by the read_file tool per call.
# MAX_READ_LINES=500
# Max file size (bytes) the file tools will read or search through. 1 MiB default.
# MAX_FILE_SIZE_BYTES=1048576
# Truncation length for execute_command output passed back to the LLM.
# EXEC_OUTPUT_TRUNCATE=10000
# Minimum delay (minutes) for one-shot scheduled tasks.
# SCHEDULE_MIN_DELAY_MIN=1
# Max recurring schedules per user. Abuse cap; bump up for trusted servers.
# MAX_SCHEDULES_PER_USER=10
# Minimum user-message / reply length (chars) to trigger automatic memory
# extraction. Short turns ("hi", "lol") are skipped to save an LLM call.
# MEMORY_EXTRACT_MIN_USER_CHARS=20
# MEMORY_EXTRACT_MIN_REPLY_CHARS=40
# Append-only NDJSON log of /forget and /export events. Useful for compliance
# / "who deleted what" audit trails. Defaults to ./audit.log.
# AUDIT_LOG_PATH=audit.log
# Set to 0 to skip writing the mister_fritz / document_engine graph-diagram
# PNGs at import time (tests/conftest.py sets this so test runs don't dirty
# the tracked images).
# FRITZ_WRITE_DIAGRAMS=1

# ----- Admin panel & web chat (bound to 127.0.0.1 only) -----
# Set a password to enable the admin panel on :8001. If unset, the panel
# won't start at all. Use any username; the password is what matters.
# ADMIN_PANEL_PASSWORD=
# ADMIN_PANEL_PORT=8001
#
# REQUIRED to enable the web chat at :8001/chat. Deliberately NOT defaulted to
# ADMIN_PANEL_PASSWORD — giving someone chat access must never hand them the
# admin panel. If this is unset the chat surface refuses every login and logs a
# warning at startup saying so.
# CHAT_PASSWORD=
# Optional comma-separated allowlist of usernames that may be claimed at
# /chat/login. Empty = any name, once the password checks out. Worth setting if
# more than one person has the password: the password decides whether you may
# be here, the username decides whose conversation you read, so without this
# anyone holding the password can type someone else's name.
# CHAT_ALLOWED_USERS=alice,bob
# Mark the chat cookie Secure. Leave off when reaching the panel over plain
# http through an SSH tunnel — Secure would silently break login there.
# CHAT_COOKIE_SECURE=false
# CHAT_SHARE_DISCORD_THREAD and CHAT_THREAD_PREFIX are RETIRED. The web chat's
# namespace now lives in the identity itself ("web-alice"), and IDENTITY_LINKS
# in the Identity section below replaces the sharing flag.
# Secret used to HMAC-sign the chat identity cookie. If unset, one is
# auto-generated and persisted to .chat_cookie_secret on first boot.
# CHAT_COOKIE_SECRET=
# Hard caps (bytes) on chat-uploaded images and documents. 10 MiB default.
# CHAT_IMAGE_UPLOAD_MAX_BYTES=10485760
# CHAT_DOC_UPLOAD_MAX_BYTES=10485760
# Syntax-highlight fenced code blocks in web-chat replies. Escape hatch: set
# false and code renders as plain <pre> blocks.
# CHAT_CODE_HIGHLIGHT=true

# ----- execute_command sandbox -----
# Comma-separated allowlist of program names execute_command may invoke. The
# argv[0] basename (sans .exe/.cmd/.bat/.ps1) must match one of these, and it
# must be a bare name — paths are rejected outright.
#
# The default list keeps interpreters (python, node, pip, npm, make, git),
# which means execute_command IS arbitrary code execution for whoever can
# reach it: `write_file("x.py", ...)` followed by `python x.py` needs no
# inline-eval flag at all. That capability is deliberate and is contained by
# the admin gate below rather than by argument parsing, which is bypassable.
# EXEC_ALLOWED_COMMANDS=ls,dir,pwd,echo,cat,type,head,tail,wc,python,python3,pip,pytest,node,npm,npx,git,go,cargo,make,grep,find,where
#
# Restricts execute_command (and only execute_command) to is_admin users. The
# other five file tools stay open to every /workspace enable holder — they are
# confined to the workspace by path resolution; running programs is not.
# Set false to restore pre-Phase-15 open access, re-accepting full RCE for
# every workspace holder.
# EXEC_REQUIRE_ADMIN=true
#
# Environment variables passed through to child processes. Everything else —
# DISCORD_BOT_TOKEN, ADMIN_PANEL_PASSWORD, CHAT_COOKIE_SECRET, OLLAMA_HOST — is
# dropped. Defaults differ by platform; PATH is always forced in. If a command
# works from a terminal but fails through the bot, add the variable it needs
# here — but think twice about proxy and index URLs, which often carry
# credentials and are exactly what this scrub exists to withhold.
# Windows default:
# EXEC_ENV_PASSTHROUGH=PATH,PATHEXT,SYSTEMROOT,WINDIR,COMSPEC,SYSTEMDRIVE,TEMP,TMP,USERPROFILE,HOMEDRIVE,HOMEPATH,APPDATA,LOCALAPPDATA,NUMBER_OF_PROCESSORS,PROCESSOR_ARCHITECTURE,OS
# POSIX default:
# EXEC_ENV_PASSTHROUGH=PATH,HOME,TMPDIR,LANG,LC_ALL,TZ,TERM,USER,LOGNAME
#
# Hard ceiling on the per-command timeout (seconds). Requests are clamped to [1, this].
# EXEC_TIMEOUT_MAX=30

# ----- Paths (defaults shown; only set if you need to override) -----
# DOC_FOLDER=./input
# CHROMA_DB_PATH=./chroma_store
# CHROMA_COLLECTION_NAME=word_docs_rag
# DB_NAME=fritz.db           # unified database for chat history + schedules
# CHAT_DB_NAME=              # override to split chat history into a separate file
# SCHEDULE_DB=               # override to split schedules into a separate file
# WORKSPACES_ROOT=./workspaces  # parent dir for per-user sandboxed workspaces

# ----- FFmpeg (only set if not on system PATH) -----
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# ----- Whisper STT (faster-whisper) -----
# Model size: tiny | base | small | medium | large-v2 | large-v3
# "small" is the recommended default — good accuracy at reasonable CPU speed.
WHISPER_MODEL=small
# Set to "cuda" if a GPU is available for much faster transcription.
WHISPER_DEVICE=cpu
# Compute type: int8 (fastest CPU), float16 (best GPU), float32 (accurate CPU)
# int8 halves memory and roughly doubles speed with minimal accuracy loss.
WHISPER_COMPUTE_TYPE=int8
# Force a specific language (e.g. "en") to skip auto-detection and speed up inference.
# Leave blank to auto-detect.
# WHISPER_LANGUAGE=
# Beam size: higher = more accurate but slower. 5 is the default.
# WHISPER_BEAM_SIZE=5
# Initial prompt seeds the transcription with context to improve accuracy on domain vocab.
# WHISPER_INITIAL_PROMPT=Mister Fritz is an AI assistant. The user is speaking a conversational message.

# ----- Telegram (optional — only needed if running main_telegram.py) -----
# TELEGRAM_BOT_TOKEN=

# ----- Identity -----
# Every store — memories, conversation threads, schedules, workspaces, the
# admin gate — is keyed off a canonical identity: "<platform>-<immutable id>",
# e.g. discord-123456789, telegram-987654321, web-alice. A dash, never a colon:
# a colon is illegal in Windows filenames and silently creates an NTFS
# alternate data stream on write.
#
# Upgrading from a version that keyed off display names? Run the migration
# BEFORE starting the bot, with the bot stopped:
#     python migrate_identity.py --dry-run
#     python migrate_identity.py --map divora=discord-123456789 --apply
# It is dry-run by default and writes a mapping file you can --reverse.

# One thread per identity per channel, so a conversation in #general no longer
# bleeds into DMs. OFF by default: turning it on BRANCHES every existing
# conversation. The identity-only thread stays in the DB untouched, but new
# messages start a fresh per-channel thread and the old context is no longer
# read. Flip it once, deliberately, not as an experiment.
# THREADS_PER_CHANNEL=false

# Compatibility shim: also match ROOT_USER / ADMIN_USERS against the caller's
# display NAME. Ships false — with it on, anyone who takes your username takes
# your admin rights. Only turn it on if you have not migrated the config yet.
# ADMIN_LEGACY_NAME_MATCH=false

# Treat one identity as another. This is how you deliberately share memories,
# schedules and conversation across surfaces — it replaces the old
# CHAT_SHARE_DISCORD_THREAD, and links the WHOLE identity rather than only the
# thread. Followed exactly one hop, so a chain is not transitive and a cycle
# cannot hang a request.
# IDENTITY_LINKS=web-alice=discord-123456789,telegram-99=discord-123456789

# ----- Debugging -----
# When set, user-facing Discord error messages append the exception type and
# text. Off by default — users get butler copy plus a log ref, and the
# traceback stays in the log. Development only.
# DISCORD_ERROR_DETAIL=0
