    "arrange"
  ],
  "phases": [
    "closed",
    "starting",
    "shown",
    "painted",
    "closing"
  ],
  "statusKeys": [
    "arrangeGen",
    "canArrange",
    "error",
    "fit",
    "instance",
    "mode",
    "open",
    "parked",
    "phase"
  ],
