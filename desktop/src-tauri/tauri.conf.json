{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mister Fritz",
  "identifier": "com.divora.fritz",
  "version": "0.1.0",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1431",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "control",
        "url": "control.html",
        "title": "Mister Fritz",
        "width": 900,
        "height": 640,
        "minWidth": 760,
        "minHeight": 520,
        "decorations": false,
        "visible": false,
        "focus": false,
        "center": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,CalculateNativeWinOcclusion,UseEcoQoSForBackgroundProcess --disable-renderer-backgrounding --disable-backgrounding-occluded-windows --disable-background-timer-throttling"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
